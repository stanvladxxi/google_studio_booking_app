    match /admins/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isAdmin() && isValidId(uid) && incoming().keys().hasAll(['email', 'createdAt']) && incoming().keys().hasOnly(['email', 'createdAt']) && incoming().email is string && incoming().email.size() <= 160 && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(uid);
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().role == 'member'
        && incoming().loyaltyPoints == 0
        && incoming().totalHoursBooked == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId) && incoming().role == existing().role && (
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['businessType', 'discoverInterests', 'newsletterSubscribed', 'newsletterTopics', 'followedInfluencerIds', 'preferredDir', 'updatedAt']) ||
            (incoming().diff(existing()).affectedKeys().hasOnly(['loyaltyPoints', 'totalHoursBooked', 'updatedAt']) && incoming().loyaltyPoints <= existing().get('loyaltyPoints', 0) + 2400 && incoming().totalHoursBooked <= existing().get('totalHoursBooked', 0) + 24)
          ))
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /spaces/{spaceId} {
      allow get: if isSignedIn() && isValidId(spaceId) && (existing().isActive == true || isAdmin() || isKitchenManager());
      allow list: if isSignedIn() && (resource.data.isActive == true || isAdmin() || isKitchenManager());
      allow create: if (isAdmin() || isKitchenManager()) && isValidId(spaceId) && isValidKitchenSpace(incoming()) && incoming().id == spaceId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if (isAdmin() || isKitchenManager()) && isValidId(spaceId) && isValidKitchenSpace(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(spaceId);
