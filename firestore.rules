      allow list: if isSignedIn() && (resource.data.isActive == true || isAdmin() || isKitchenManager());
      allow create: if (isAdmin() || isKitchenManager()) && isValidId(equipmentId) && isValidEquipment(incoming()) && incoming().id == equipmentId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if (isAdmin() || isKitchenManager()) && isValidId(equipmentId) && isValidEquipment(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(equipmentId);
    }

    match /availabilitySlots/{slotId} {
      allow get: if isSignedIn() && isValidId(slotId) && existing().status in ['confirmed', 'in-progress', 'completed', 'cancelled'];
      allow list: if isSignedIn() && resource.data.status in ['confirmed', 'in-progress', 'completed'];
      allow create: if isVerifiedUser()
        && canBookRole()
        && isValidId(slotId)
        && isValidAvailabilitySlot(incoming())
        && (incoming().ownerId == request.auth.uid || isAdmin())
        && incoming().bookingId == slotId
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId));
      allow update: if isVerifiedUser()
        && isValidId(slotId)
        && isValidAvailabilitySlot(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().bookingId == existing().bookingId
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid && canBookRole() && existing().status != 'completed' && existing().status != 'cancelled' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().status == 'cancelled')
        );
      allow delete: if isAdmin() && isValidId(slotId);
