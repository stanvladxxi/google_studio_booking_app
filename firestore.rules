          (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['responseCount', 'bestBatchNumber', 'bestBatchScore', 'willingToPayPct', 'avgSweetness', 'customQuestions', 'updatedAt']))
        );
      allow delete: if isVerifiedUser() && isValidId(formDocId) && (existing().ownerId == request.auth.uid || isAdmin());
