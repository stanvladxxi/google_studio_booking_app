    function isValidExperiment(data) {
      return data.keys().hasAll(['id', 'productId', 'ownerId', 'objective', 'baselineVersionId', 'variableChanged', 'experimentVersionId', 'expectedResult', 'decision', 'createdAt', 'updatedAt'])
